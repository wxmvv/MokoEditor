{
	"name": "moko",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"start": "vite",
		"dev:web": "vite",
		"dev:electron": "node scripts/dev-electron.mjs",
		"build": "tsc -b && vite build",
		"test": "node --test",
		"lint": "eslint .",
		"preview": "vite preview",
		"electron:start": "cross-env NODE_ENV=development electron .",
		"electron:start:prod": "cross-env NODE_ENV=production electron .",
		"electron:build": "tsc -b && vite build && cross-env NODE_ENV=production electron-builder"
	},
	"main": "electron.cjs",
	"homepage": ".",
	"build": {
		"appId": "com.example.Moko",
		"productName": "Moko",
		"directories": {
			"output": "electron-build"
		},
		"files": [
			"app/**/*",
			"app/**/**/*",
			"electron.cjs",
			"electron-menu.cjs",
			"electron-preload.cjs"
		],
		"mac": {
			"target": "dmg",
			"icon": "build/icon.icns"
		},
		"win": {
			"target": "nsis",
			"icon": "build/icon.ico"
		},
		"linux": {
			"target": "AppImage",
			"icon": "build/icon.png"
		}
	},
	"dependencies": {
		"@capacitor/android": "^8.1.0",
		"@capacitor/cli": "^8.1.0",
		"@capacitor/core": "^8.1.0",
		"@capacitor/ios": "^8.1.0",
		"@codemirror/autocomplete": "^6.20.1",
		"@codemirror/collab": "^6.1.1",
		"@codemirror/commands": "^6.10.3",
		"@codemirror/language": "^6.12.2",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/lint": "^6.9.5",
		"@codemirror/search": "^6.6.0",
		"@codemirror/state": "^6.5.4",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.40.0",
		"@ddietr/codemirror-themes": "^1.5.2",
		"@lezer/highlight": "^1.2.3",
		"chokidar": "^5.0.0",
		"codemirror": "^6.0.2",
		"fuse.js": "^7.1.0",
		"json5": "^2.2.3",
		"micromatch": "^4.0.8",
		"p-queue": "^9.1.0",
		"react": "^19.2.4",
		"react-complex-tree": "^2.6.1",
		"react-dom": "^19.2.4",
		"thememirror": "^2.0.1",
		"ua-parser-js": "^2.0.9"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.1.4",
		"cross-env": "^10.1.0",
		"electron": "^41.0.3",
		"electron-builder": "^26.8.1",
		"electron-devtools-installer": "^4.0.0",
		"eslint": "^9.39.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.0.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.4.0",
		"rollup-plugin-copy": "^3.5.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "^7.3.1",
		"vite-plugin-static-copy": "^3.3.0",
		"vite-plugin-svgr": "^4.5.0"
	}
}
